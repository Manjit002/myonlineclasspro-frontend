# ─── Backend API ──────────────────────────────────────────────
# Spring Boot backend. This is the ONLY backend API origin for the
# application; it must always be https.
#
# The deprecated AWS load-balancer origin previously used for this
# backend has been fully retired. It is not referenced anywhere in the
# project and there is no fallback path to it — do not reintroduce it.
#
# Public base URL only — never put backend secrets or Stripe secret
# keys in NEXT_PUBLIC_* values, they are inlined into the client bundle.
NEXT_PUBLIC_API_BASE_URL=https://main.myonlineclasspro.com

# Optional override, only if auth is ever served from a separate host.
# Leave unset: auth falls back to NEXT_PUBLIC_API_BASE_URL above.
# NEXT_PUBLIC_AUTH_API_URL=https://main.myonlineclasspro.com

# ─── Reviews ─────────────────────────────────────────────────
# Reviews now come straight from the Spring Boot API at
# NEXT_PUBLIC_API_BASE_URL + /api/reviews. The old reviews-proxy.php on
# the marketing site is no longer used — it was returning 404, which is
# what surfaced as "Could not load reviews (404)" on the reviews page.
# No separate reviews variable is needed.